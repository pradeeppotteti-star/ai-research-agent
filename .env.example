# Backend Environment Variables
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/evidence_research_agent?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# LLM API Keys (Optional - Intelligent fallback active if empty)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Academic Search Provider API Keys (Optional - Free public APIs operate without keys)
SEMANTIC_SCHOLAR_API_KEY=
ELSEVIER_API_KEY=
IEEE_API_KEY=

# Frontend Environment Variables (Safe for browser)
VITE_API_BASE_URL=http://localhost:5000/api
